 void send_session_identification() {
+#ifdef __ORBIS__
+	const char identification[] = LOCAL_IDENT "\r\n";
+	size_t offset = 0;
+	while (offset < sizeof(identification) - 1) {
+		ssize_t written;
+#ifdef MSG_NOSIGNAL
+		written = send(ses.sock_out, identification + offset,
+				(sizeof(identification) - 1) - offset, MSG_NOSIGNAL);
+#else
+		written = write(ses.sock_out, identification + offset,
+				(sizeof(identification) - 1) - offset);
+#endif
+		if (written < 0 && errno == EINTR) continue;
+		if (written <= 0) dropbear_exit("failed to send identification: %s", strerror(errno));
+		offset += (size_t)written;
+	}
+#else
 	buffer *writebuf = buf_new(strlen(LOCAL_IDENT "\r\n") + 1);
 	buf_putbytes(writebuf, (const unsigned char *) LOCAL_IDENT "\r\n", strlen(LOCAL_IDENT "\r\n"));
 	writebuf_enqueue(writebuf);
+#endif
 }
 
